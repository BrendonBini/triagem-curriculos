# Copie este arquivo para ".env" (na mesma pasta) e preencha a sua chave.
#   copy .env.example .env    (PowerShell / CMD)
#   cp .env.example .env       (Git Bash / Linux / Mac)

# Qual IA usar: "gemini" (gratis, padrao) ou "anthropic".
AI_PROVIDER=gemini

# ---- Gemini (Google AI Studio) - free tier ----
# Pegue a chave em: https://aistudio.google.com/apikey
GEMINI_API_KEY=coloque-sua-chave-do-gemini-aqui
# Opcional. Padrao: gemini-flash-latest (alias sempre atual, com free tier).
# Alternativas: gemini-flash-lite-latest, gemini-2.5-flash-lite
GEMINI_MODEL=gemini-flash-latest

# ---- Anthropic (opcional; so se AI_PROVIDER=anthropic) ----
# Pegue a chave em: https://console.anthropic.com/  ->  API Keys
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# ANTHROPIC_MODEL=claude-sonnet-5

# Opcional: porta do servidor.
PORT=3001

# =====================================================================
# VIGIA DE E-MAIL (IMAP) — importa currículos automaticamente da caixa.
# Recurso OPCIONAL. Se IMAP_HOST, IMAP_USER e IMAP_PASSWORD faltarem, o
# vigia fica DESLIGADO e o servidor sobe normalmente.
#
# ATENÇÃO DE SEGURANÇA: este arquivo (.env.example) NÃO é gitignored.
# NÃO cole senha/host reais aqui — deixe SEMPRE em branco. Preencha os
# valores apenas no seu server/.env local (esse sim é ignorado pelo git).
# A caixa é aberta em MODO SOMENTE LEITURA (não marca lido/move/apaga).
# =====================================================================

# --- Conexão IMAP (deixe em branco aqui; preencha só no .env) ---
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=

# Palavras-chave do ASSUNTO que marcam um e-mail como candidatura
# (lista separada por vírgula; comparação sem acento e case-insensitive).
CV_SUBJECT_KEYWORDS=curriculo,currículo,vaga,candidatura

# Intervalo de verificação da caixa, em minutos.
POLL_INTERVAL_MIN=10

# Na 1ª ativação, quantos dias para trás considerar (0 = só e-mails novos
# a partir de agora). Evita importar todo o histórico da caixa de uma vez.
INITIAL_LOOKBACK_DAYS=0

# =====================================================================
# CONTEXTO DE SETOR (opcional) — ajuda a IA a pesar a relevância da
# experiência do candidato ao ramo. Preencha SOMENTE no server/.env local
# (este .env.example é versionado — NÃO coloque dados reais da empresa aqui).
# Exemplo genérico:
#   EMPLOYER_CONTEXT=Distribuidora de bebidas; funções: motorista entregador, vendedor externo, repositor, auxiliar de depósito.
# =====================================================================
EMPLOYER_CONTEXT=
